<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AI 远程控制无障碍服务：仅在 debug 构建中启用 -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <application>
        <service
            android:name=".accessibility.PoLangAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 备份/恢复脚本化入口：仅 debug 构建，配合 scripts/app-data-backup.sh -->
        <receiver
            android:name=".testing.backup.BackupRestoreBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mamba.picme.AGENT_TEST" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
