[Unit]
Description=chisel client (claude-tunnel: egress + reverse SSH R:3022)
After=network.target gateway.service

[Service]
EnvironmentFile=/root/claude-tunnel.env
ExecStart=/bin/sh -c 'exec /usr/local/bin/chisel client --auth "$CHISEL_PSK" https://api.polang.net/tunnel R:3001:127.0.0.1:3000 R:3022:127.0.0.1:22'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
