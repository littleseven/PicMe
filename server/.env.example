# PicMe Server 配置（复制为 .env 本地用；生产放 /etc/picme/server.env，systemd EnvironmentFile 读）

# 服务
HOST=127.0.0.1
PORT=8080
DB_PATH=/var/lib/picme/picme.db

# LLM —— DeepSeek，经 腾讯 TokenHub 或 Cloudflare AI Gateway（均 OpenAI 兼容）；三选一取消注释
# 1) DeepSeek 直连（兜底默认）
LLM_BASE_URL=https://api.deepseek.com/v1
# 2) 腾讯 TokenHub
# LLM_BASE_URL=https://api.tokenhub.tencent.com/v1
# 3) Cloudflare AI Gateway
# LLM_BASE_URL=https://<gateway-id>.aigateway.cloudflare.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_DAILY_BUDGET_CNY=20

# 限流（已按用户放宽）
RATE_LIMIT_PER_MIN=100

# 腾讯 COS（HK, 100GB）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-hongkong
COS_BUCKET=
COS_PRESIGN_TTL_MIN=60
