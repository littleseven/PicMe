    "Photos, beauty filters, facial keypoints, OCR text, media location, and chat memory are all processed locally on your device and are never uploaded to a server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, beauty filters, facial keypoints, OCR text, media location, and chat memory are all processed locally on your device and are never uploaded to a server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片、美颜滤镜、人脸关键点、OCR 文字、媒体位置和聊天记忆全部在设备本地处理，绝不上传至服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片、美顏濾鏡、人臉關鍵點、OCR 文字、媒體位置和聊天記憶全部在裝置本機處理，絕不上傳伺服器。"
          }
        }
      }
    },
