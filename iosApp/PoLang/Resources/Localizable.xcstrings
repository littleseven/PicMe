    "You can delete your account through Settings → Account → Delete Account, or by emailing us.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can delete your account through Settings → Account → Delete Account, or by emailing us."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以通过「设置 → 账号 → 删除账号」删除账号，或邮件联系我们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以透過「設定 → 帳號 → 刪除帳號」刪除帳號，或來信聯絡我們。"
          }
        }
      }
    },
    "You've chatted %lld rounds with me 🎉 Register to claim free quota, or configure your own LLM Token — either works to keep chatting!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've chatted %lld rounds with me 🎉 Register to claim free quota, or configure your own LLM Token — either works to keep chatting!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经和我聊了 %lld 轮啦 🎉 注册可领取免费额度，或配置自己的 LLM Token，二选一即可继续畅聊～"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經和我聊了 %lld 輪啦 🎉 註冊可領取免費額度，或配置自己的 LLM Token，二選一即可繼續暢聊～"
          }
        }
      }
    },
    "Your email is used only for authentication and LLM free trial usage counting (default 100 times). No passwords are collected — login uses email verification codes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email is used only for authentication and LLM free trial usage counting (default 100 times). No passwords are collected — login uses email verification codes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于账号登录和 LLM 免费试用次数统计（默认 100 次）。不收集密码，登录使用邮箱验证码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於帳號登入和 LLM 免費試用次數統計（預設 100 次）。不收集密碼，登入使用郵件驗證碼。"
          }
        }
      }
    },
