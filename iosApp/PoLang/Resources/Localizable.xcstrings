    "A device identifier is generated to count free trial usage for unregistered guests. This identifier is sent to api.polang.net and is not used for personal identification or shared with third parties.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device identifier is generated to count free trial usage for unregistered guests. This identifier is sent to api.polang.net and is not used for personal identification or shared with third parties."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成设备标识符用于统计未注册访客的免费试用次数。该标识符发送至 api.polang.net，不用于个人身份识别，也不与第三方共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生裝置識別碼用於統計未註冊訪客的免費試用次數。該識別碼傳送至 api.polang.net，不用於個人身份識別，也不與第三方共享。"
          }
        }
      }
    },
