    "Without a configured model, PoLang uses a free proxy server with limited guest quota. Add your own API key for unlimited access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a configured model, PoLang uses a free proxy server with limited guest quota. Add your own API key for unlimited access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置模型时，PoLang 使用免费代理服务器（访客额度有限）。添加自有 API Key 可解除限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定模型時，PoLang 使用免費代理伺服器（訪客額度有限）。新增自有 API Key 可解除限制。"
          }
        }
      }
    },
