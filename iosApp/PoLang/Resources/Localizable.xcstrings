          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 仅支持 Florence-2。Qwen3-VL 打标在 iOS 不可用，选择后回退到 Florence-2。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 僅支援 Florence-2。Qwen3-VL 打標在 iOS 不可用，選擇後回退到 Florence-2。"
          }
        }
      }
    },
    "iOS uses a single fixed pipeline (CPU only). Per-stage models, GPU and interval profiles are not configurable on iOS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS uses a single fixed pipeline (CPU only). Per-stage models, GPU and interval profiles are not configurable on iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 使用固定单一管线（仅 CPU），不支持阶段独立模型、GPU 与间隔档位配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 使用固定單一管線（僅 CPU），不支援階段獨立模型、GPU 與間隔檔位配置。"
          }
        }
      }
    },
