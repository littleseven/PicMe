{
  "_comment": "PoLang 双端 Design Token SSOT。Android/iOS 各自从此文件同步到代码常量。修改 token 时先改此文件，再两端同步。完整提取方法学/漂移记录见 docs/03-TECHNICAL-SPECS/DESIGN_TOKENS_SPEC.md。",
  "_version": "2.0.0",
  "_updated": "2026-08-09",

  "spacing": {
    "_comment": "语义间距阶梯。屏幕级 padding 多为 md(12)/lg(16)，组件内 gap 多为 sm(8)。",
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },

  "radius": {
    "_comment": "圆角阶梯。panel=底部面板顶角; card=卡片/模型卡; button=按钮/标签; small=辅助元素; thumbnail=网格缩略图。",
    "panel": 24,
    "card": 12,
    "button": 10,
    "small": 8,
    "thumbnail": 2
  },

  "icon": {
    "sm": 18,
    "md": 22,
    "lg": 24,
    "xl": 32
  },

  "topBar": {
    "_comment": "AppTopBar 通用顶栏（Gallery/Settings/Editor 共享）。titleFontSize 17sp 为非 M3 标准定制值。",
    "height": 48,
    "buttonSize": 36,
    "iconSize": 22,
    "titleFontSize": 17,
    "titleFontWeight": "Medium",
    "spacing": 8,
    "horizontalPadding": 8
  },

  "shutter": {
    "_comment": "相机快门。diameter=外环; innerDiameter=照片态内核; 录像态内核缩为 28dp 4dp 圆角方。",
    "diameter": 76,
    "innerDiameter": 58,
    "recordingInnerDiameter": 28,
    "recordingInnerCornerRadius": 4,
    "ringWidth": 4,
    "pressDebounceMs": 500,
    "flashAlpha": 0.6,
    "flashFadeMs": 80
  },

  "beautyPanel": {
    "_comment": "相机美颜面板容器。slider 控件完整规格见 appSlider。",
    "topCornerRadius": 24,
    "iconSize": 24,
    "sliderThumbSize": 18,
    "sliderTrackHeight": 6,
    "heightRatio": 0.35,
    "heightRatioMin": 0.2,
    "heightRatioMax": 0.75
  },

  "grid": {
    "_comment": "相册/搜索网格。方形 Crop，minCellSize 控制列数。",
    "minCellSize": 110,
    "spacing": 2,
    "cornerRadius": 2
  },

  "pager": {
    "_comment": "4 页 App Shell（Camera=0/Gallery=1/Chat=2/People=3）HorizontalPager。",
    "pageSpacing": 16,
    "actionIconSize": 32,
    "overlayMaxWidth": 400,
    "overlayMaxHeight": 500
  },

  "color": {
    "_comment": "不随主题切换的固定功能色。随主题切换的语义色见 colorScheme。",
    "focusRing": "#FF00E5FF",
    "panelBackground": "#CC000000",
    "shutterRing": "#FFFFFFFF",
    "sliderThumb": "#FFFFFFFF",
    "vibrantGreen": "#FF00E676",
    "vibrantBlue": "#FF2979FF",
    "vibrantOrange": "#FFFF9100",
    "vibrantPink": "#FFFF4081"
  },

  "typography": {
    "_comment": "M3 baseline 字号阶梯。仅 bodyLarge 为定制（Typography.kt），其余皆为 M3 默认。size/lineHeight/letterSpacing 单位 sp。iOS 映射：role→(size, weight→SwiftUI Font.Weight: Normal=.regular, Medium=.medium)。",
    "displayLarge":  { "size": 57, "lineHeight": 64, "weight": "Normal", "letterSpacing": -0.25 },
    "displayMedium": { "size": 45, "lineHeight": 52, "weight": "Normal", "letterSpacing": 0 },
    "displaySmall":  { "size": 36, "lineHeight": 44, "weight": "Normal", "letterSpacing": 0 },
    "headlineLarge": { "size": 32, "lineHeight": 40, "weight": "Normal", "letterSpacing": 0 },
    "headlineMedium":{ "size": 28, "lineHeight": 36, "weight": "Normal", "letterSpacing": 0 },
    "headlineSmall": { "size": 24, "lineHeight": 32, "weight": "Normal", "letterSpacing": 0 },
    "titleLarge":    { "size": 22, "lineHeight": 28, "weight": "Normal", "letterSpacing": 0 },
    "titleMedium":   { "size": 16, "lineHeight": 24, "weight": "Medium", "letterSpacing": 0.15 },
    "titleSmall":    { "size": 14, "lineHeight": 20, "weight": "Medium", "letterSpacing": 0.1 },
    "bodyLarge":     { "size": 16, "lineHeight": 24, "weight": "Normal", "letterSpacing": 0.5 },
    "bodyMedium":    { "size": 14, "lineHeight": 20, "weight": "Normal", "letterSpacing": 0.25 },
    "bodySmall":     { "size": 12, "lineHeight": 16, "weight": "Normal", "letterSpacing": 0.4 },
    "labelLarge":    { "size": 14, "lineHeight": 20, "weight": "Medium", "letterSpacing": 0.1 },
    "labelMedium":   { "size": 12, "lineHeight": 16, "weight": "Medium", "letterSpacing": 0.5 },
    "labelSmall":    { "size": 11, "lineHeight": 16, "weight": "Medium", "letterSpacing": 0.5 }
  },

  "colorScheme": {
    "_comment": "M3 baseline 配色 light/dark。Android Color.kt/Theme.kt 值；surfaceVariant/outline/containers 为 M3 默认（Theme.kt 未显式设置）。iOS 须用这些 ARGB hex 作为语义色基准（iOS 无 Material You 动态取色）。注意：Android 端 ErrorLight=Color(0xB32610) 有 alpha=00 透明 bug、Dark tertiaryContainer/onTertiaryContainer 误指向 TertiaryDark，此处已修正为 M3 标准值。",
    "light": {
      "primary": "#FF6750A4",
      "onPrimary": "#FFFFFFFF",
      "primaryContainer": "#FFEADDFF",
      "onPrimaryContainer": "#FF21005D",
      "secondary": "#FF625B71",
      "onSecondary": "#FFFFFFFF",
      "secondaryContainer": "#FFE8DEF8",
      "onSecondaryContainer": "#FF1D192B",
      "tertiary": "#FF7D5260",
      "onTertiary": "#FFFFFFFF",
      "tertiaryContainer": "#FFFFD8E4",
      "onTertiaryContainer": "#FF31111D",
      "error": "#FFB3261E",
      "onError": "#FFFFFFFF",
      "errorContainer": "#FFF9DEDC",
      "onErrorContainer": "#FF410E0B",
      "background": "#FFFFFBFE",
      "onBackground": "#FF1C1B1F",
      "surface": "#FFFFFBFE",
      "onSurface": "#FF1C1B1F",
      "surfaceVariant": "#FFE7E0EC",
      "onSurfaceVariant": "#FF49454F",
      "outline": "#FF79747E",
      "outlineVariant": "#FFCAC4D0",
      "surfaceContainerLowest": "#FFFFFFFF",
      "surfaceContainerLow": "#FFF7F2FA",
      "surfaceContainer": "#FFF3EDF7",
      "surfaceContainerHigh": "#FFEDE7F0",
      "surfaceContainerHighest": "#FFE6E0E9"
    },
    "dark": {
      "primary": "#FFD0BCFF",
      "onPrimary": "#FF381E72",
      "primaryContainer": "#FF4F378B",
      "onPrimaryContainer": "#FFEADDFF",
      "secondary": "#FFCCC2DC",
      "onSecondary": "#FF332D41",
      "secondaryContainer": "#FF4A4458",
      "onSecondaryContainer": "#FFE8DEF8",
      "tertiary": "#FFEFB8C8",
      "onTertiary": "#FF492532",
      "tertiaryContainer": "#FF633B48",
      "onTertiaryContainer": "#FFFFD8E4",
      "error": "#FFF2B8B5",
      "onError": "#FF601410",
      "errorContainer": "#FF8C1D18",
      "onErrorContainer": "#FFF9DEDC",
      "background": "#FF1C1B1F",
      "onBackground": "#FFE6E1E5",
      "surface": "#FF1C1B1F",
      "onSurface": "#FFE6E1E5",
      "surfaceVariant": "#FF49454F",
      "onSurfaceVariant": "#FFCAC4D0",
      "outline": "#FF938F99",
      "outlineVariant": "#FF49454F",
      "surfaceContainerLowest": "#FF0F0D13",
      "surfaceContainerLow": "#FF1D1B20",
      "surfaceContainer": "#FF211F26",
      "surfaceContainerHigh": "#FF2B2930",
      "surfaceContainerHighest": "#FF36343B"
    }
  },

  "alpha": {
    "_comment": "透明度语义阶梯。绝大多数派生色 = colorScheme 角色 .copy(alpha=N)，如 onSurface@0.6=次要文本。iOS 须照搬这些 alpha 值以保证层级感还原。",
    "scrimModal": 0.7,
    "scrim": 0.55,
    "scrimDeep": 0.82,
    "surfaceTranslucent": 0.95,
    "fieldBackground": 0.7,
    "primaryTint": 0.12,
    "primaryTintSoft": 0.15,
    "primaryTintMedium": 0.2,
    "primaryTintStrong": 0.25,
    "emphasisHigh": 0.85,
    "emphasis": 0.8,
    "secondary": 0.6,
    "hint": 0.5,
    "placeholder": 0.4,
    "faint": 0.3,
    "ghost": 0.2
  },

  "statusColor": {
    "_comment": "语义状态色（不随主题）。success/warning/error/info 跨 camera/chat/settings/idphoto/tag 复用。注意 statusError(#E53935)=产品 Material Red，与 colorScheme.error(#B3261E M3) 不同。",
    "success": "#FF4CAF50",
    "warning": "#FFFF9800",
    "warningAmber": "#FFFFA000",
    "error": "#FFE53935",
    "info": "#FF2196F3"
  },

  "motion": {
    "_comment": "动效时长(ms)+缓动。规范：禁用线性(Linear)，统一 FastOutSlowIn/Standard。drift: MainActivity nav 过渡 tween(400) 未指定 easing，应补 FastOutSlowIn。",
    "durationMs": {
      "instant": 80,
      "fast": 150,
      "medium": 300,
      "slow": 400,
      "blink": 500,
      "pulse": 1200
    },
    "staggerMs": 160,
    "searchDebounceMs": 300,
    "shutterDebounceMs": 500,
    "easing": {
      "standard": "FastOutSlowInEasing",
      "emphasized": "CubicBezierEasing(0.2,0.0,0.0,1.0)"
    },
    "galleryPreview": {
      "_comment": "相册预览进场：fade(medium)+scale(slow)，scale 区间 0.2↔1.0。",
      "fadeMs": 300,
      "scaleMs": 400,
      "scaleFrom": 0.2,
      "scaleTo": 1.0
    }
  },

  "elevation": {
    "_comment": "阴影/tonal 阶梯(dp)。settings 卡片=none; 模型卡=low; 选中 chip/滑块 thumb=medium; chat 输入卡=high; 悬浮 Tab=floating; 底部面板=sheet。",
    "none": 0,
    "low": 1,
    "medium": 2,
    "high": 4,
    "floating": 6,
    "sheet": 16
  },

  "appSlider": {
    "_comment": "全 app 统一滑杆（HyperOS 风）：胶囊轨道+白圆点 primary 描边 thumb+按压放大。camera/editor/beauty 共享。颜色取 colorScheme.primary/onSurface。",
    "trackHeight": 6,
    "trackShape": "capsule",
    "thumbSize": 18,
    "thumbPressedScale": 1.15,
    "thumbShadowElevation": 2,
    "thumbBorderWidth": 2,
    "thumbBorderColor": "primary",
    "thumbColor": "#FFFFFFFF",
    "inactiveTrackAlpha": 0.12,
    "activeTrackColor": "primary",
    "animDurationMs": 150,
    "animEasing": "FastOutSlowInEasing"
  },

  "bottomTab": {
    "_comment": "悬浮底部胶囊导航（FloatingBottomTab），主入口聚合。v1 SSOT 漏配 cornerRadius=28，已补。color=surface。",
    "cornerRadius": 28,
    "tonalElevation": 3,
    "shadowElevation": 6,
    "containerPaddingH": 12,
    "containerPaddingV": 8,
    "itemPaddingH": 16,
    "itemPaddingVIconOnly": 10,
    "itemPaddingVWithLabel": 4,
    "iconSize": 24,
    "iconTint": "onSurface",
    "labelStyle": "labelSmall",
    "labelColor": "onSurface",
    "labelTopPadding": 2
  },

  "bottomSheet": {
    "_comment": "相机/编辑器共享底部面板外壳（ControlPanel/BeautyPanel/ProMode/EditorPanel）。强制深色场景：surface@0.95 + 渐变 scrim。",
    "topCornerRadius": 24,
    "shadowElevation": 16,
    "surfaceAlpha": 0.95,
    "borderWidth": 0.5,
    "borderColorAlpha": 0.25,
    "gradientStops": ["transparent", "black@0.55", "black@0.82"],
    "handleWidth": 36,
    "handleHeight": 4,
    "handleColorAlpha": 0.2,
    "contentPaddingH": 24,
    "contentPaddingV": 8,
    "contentSpacing": 12
  },

  "chip": {
    "_comment": "通用 FilterChip/AssistChip 几何。M3 默认组件 + 以下定制。selected=primary 系，unselected=surfaceVariant@0.5。",
    "height": 36,
    "smallHeight": 32,
    "selectedContainer": "primaryContainer",
    "unselectedContainerAlpha": 0.5,
    "unselectedContainerRole": "surfaceVariant",
    "selectedShadowElevation": 2,
    "labelStyle": "labelLarge"
  },

  "badge": {
    "_comment": "标签徽章（模型卡 tag badge / 模型 must-have 必备徽章）。primary@0.12 bg + 圆点。",
    "tagRadius": 6,
    "tagBackgroundAlpha": 0.12,
    "tagDotSize": 6,
    "tagPaddingH": 8,
    "tagPaddingV": 3,
    "tagDotLabelGap": 4,
    "tagLabelStyle": "labelSmall",
    "miniRadius": 4,
    "requiredRadius": 4,
    "requiredBg": "#FFE53935",
    "requiredLabelStyle": "labelSmall",
    "requiredLabelWeight": "Bold",
    "requiredLabelColor": "#FFFFFFFF"
  },

  "camera": {
    "_comment": "相机强制深色 overlay 专属。focusRing 复用 color.focusRing。controlButton idle=Black@0.5/active=primary。",
    "focusRingDiameter": 100,
    "focusRingStrokeWidth": 3,
    "focusRingCornerRadius": 20,
    "focusRingCrossLength": 16,
    "controlButtonSize": 48,
    "controlButtonIconSize": 24,
    "controlButtonIdleAlpha": 0.5,
    "modeTabFontSize": 13,
    "modeTabSelectedWeight": "Bold",
    "modeTabUnselectedAlpha": 0.6,
    "voicePulseMs": 1200,
    "voicePulseAlphaFrom": 0.3,
    "voicePulseAlphaTo": 1.0,
    "filterSelectorColumns": 5,
    "filterSelectorHeight": 280,
    "filterSelectedScale": 1.08,
    "filterSelectedBorderWidth": 2.5
  },

  "chatBubble": {
    "_comment": "聊天气泡。两套：ChatScreen(M3 浅色 DeepSeek 白卡输入) vs AiChatScreen(深色 overlay 黑底)。bubble 不对称圆角（tail 侧小）。",
    "bubbleMaxWidth": 360,
    "imageMaxWidth": 240,
    "paddingH": 16,
    "paddingV": 12,
    "cornerRadius": 20,
    "tailCornerRadius": 4,
    "textSize": 14,
    "textLineHeight": 20,
    "inputCornerRadius": 24,
    "inputShadowElevation": 4,
    "capsuleCornerRadius": 16,
    "capsuleActiveAlpha": 0.12,
    "capsuleInactiveAlpha": 0.5,
    "overlayBubbleColor": "#FF2D2D2D",
    "overlayPanelColor": "black",
    "overlayPanelCornerRadius": 20,
    "typingMs": 400,
    "blinkMs": 500
  },

  "settings": {
    "_comment": "设置页通用结构。SettingsClickableRow=主行模式，section=分组卡片容器。颜色全走 colorScheme 角色。",
    "rowHeightNoSubtitle": 56,
    "rowHeightWithSubtitle": 64,
    "rowPaddingH": 12,
    "rowElementGap": 12,
    "rowLeadingIconSize": 24,
    "rowLeadingIconTint": "primary",
    "rowChevronSize": 20,
    "rowChevronAlpha": 0.6,
    "toggleRowHeight": 44,
    "sectionPaddingH": 12,
    "sectionPaddingV": 10,
    "sectionContainer": "surfaceContainerHighest",
    "heroAvatarSize": 48,
    "heroAvatarBg": "primaryContainer",
    "categoryCardIconSize": 28,
    "categoryCardIconTint": "primary"
  },

  "editor": {
    "_comment": "图片编辑器组件几何（结构 token）。内容色板（markup 7 色/lip 12 色/blush 3 色）见 DESIGN_TOKENS_SPEC.md palette 附录，属产品内容数据不入 token。",
    "filterPanelHeight": 120,
    "filterItemWidth": 72,
    "filterThumbSize": 64,
    "filterLabelSize": 10,
    "filterSelectedBorderWidth": 3,
    "filterUnselectedBorderWidth": 1,
    "gachaCardThumbSize": 84,
    "gachaCardCornerRadius": 8,
    "gachaCardThumbCornerRadius": 6,
    "checkerboardCellSize": 16,
    "checkerboardLight": "#FFE6E6E6",
    "checkerboardDark": "#FFBDBDBD",
    "cropTransformButtonSize": 44,
    "cropTransformButtonBgAlpha": 0.45,
    "adjustPanelMaxHeight": 220,
    "markupSwatchSelected": 32,
    "markupSwatchUnselected": 24
  },

  "modelCenter": {
    "_comment": "模型下载中心专属 token。getTagColor 代码用主题角色(recommended/chat/beauty-camera→tertiary/primary)与下方固定 hex 存在分歧，iOS 以本表固定 hex 为准。",
    "tagColorMustHave": "#FFE53935",
    "tagColorRecommended": "#FFFF9800",
    "tagColorChat": "#FF2196F3",
    "tagColorPhotoTagging": "#FF9C27B0",
    "tagColorBeautyCamera": "#FFFF9800",
    "tagColorDefault": "#FF9E9E9E",
    "requiredBadgeBg": "#FFE53935",
    "chipHeight": 36,
    "chipIconSize": 14,
    "actionButtonSize": 36,
    "actionButtonSmallSize": 32,
    "tagBadgeRadius": 6,
    "miniBadgeRadius": 4,
    "tagBadgeDotSize": 6
  }
